# NeuralOps Next.js Frontend - Vercel Deployment Environment Variables
# Copy this file to .env.local or add these keys directly in the Vercel Dashboard project settings.

# 1. Base URL for Ingestion Service (REST API backend)
# Example: https://api.neuralops.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Base HTTP URL for Alerting Service (GraphQL Gateway backend)
# Example: https://alerts.neuralops.yourdomain.com/graphql
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# 3. Base WebSocket URL for Alerting Service GraphQL Subscriptions (real-time notifications)
# Example: wss://alerts.neuralops.yourdomain.com/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql
